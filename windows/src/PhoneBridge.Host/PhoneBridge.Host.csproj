<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PhoneBridge</AssemblyName>
    <RootNamespace>PhoneBridge.Host</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF needs the manifest for per-monitor DPI; the WinForms analyzer only knows its own API. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms (tray icon only) both define Application, Clipboard...: no global usings for WinForms/Drawing. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../scripts/firewall.ps1" Link="scripts/firewall.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhoneBridge.Core\PhoneBridge.Core.csproj" />
    <ProjectReference Include="..\PhoneBridge.Server\PhoneBridge.Server.csproj" />
    <ProjectReference Include="..\PhoneBridge.Bluetooth\PhoneBridge.Bluetooth.csproj" />
  </ItemGroup>

</Project>
